in/pages/bob-cli-fc/[bold #87AFFF][/#87AFFF]README.md[/bold #87AFFF]\n[dim]  1 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Drawer bullets in the capture grammar[/bold #D7AFFF]                         [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]drawer-bullets[dim] · [dim][/dim]no dependencies[/#AF87FF][/dim]\n    [#D7D7AF]drawer-bullets: make a first-level bullet's leading `#` a drawer [/#D7D7AF]\n    [#D7D7AF]shortcut instead of a type marker, recognize drawer bullets on new tasks[/#D7D7AF]\n    [#D7D7AF]and new project notes, render and merge them through the commit [/#D7D7AF]\n    [#D7D7AF]resolver, report them in capture-parse, and bump the grammar to 4.[/#D7D7AF]\n[dim]  2 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Several notes on one existing task[/bold #D7AFFF]                            [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]note-bullets[dim] · [dim][/dim]after drawer-bullets[/#AF87FF][/dim]\n    [#D7D7AF]note-bullets: let a note-less `@route+id` (or `@route+id#drawer`) item [/#D7D7AF]\n    [#D7D7AF]file each first-level bullet as its own note, file drawer bullets into [/#D7D7AF]\n    [#D7D7AF]the target's drawers, and report notes and drawers in JSON and human [/#D7D7AF]\n    [#D7D7AF]output.[/#D7D7AF]\n[dim]  3 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Bullet drawer menu, docs, and memory records[/bold #D7AFFF]                  [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]bullet-menu[dim] · [dim][/dim]after note-bullets[/#AF87FF][/dim]\n    [#D7D7AF]bullet-menu: open the drawer completion menu at a first-level bullet's [/#D7D7AF]\n    [#D7D7AF]`#`, replace with the bare ALL-CAPS title (plus the optional [/#D7D7AF]\n    [#D7D7AF]nested-bullet continuation), finish the docs, and write the accepted [/#D7D7AF]\n    [#D7D7AF]memory records.[/#D7D7AF]\n[dim]  4 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Bob Mac Capture presentation[/bold #D7AFFF]                                  [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]mac-capture[dim] · [dim][/dim]after note-bullets, bullet-menu[/#AF87FF][/dim]\n    [#D7D7AF]mac-capture: paint drawer-bullet spans, summarize multi-note sub-bullet [/#D7D7AF]\n    [#D7D7AF]previews from the new `notes`/`drawers` fields, and prove the bullet [/#D7D7AF]\n    [#D7D7AF]drawer menu end to end with real-bob fixtures.[/#D7D7AF]","clan_tribe":"epic","epic_bead_id":"bob-cli-fc","llm_provider":"grok","model":"grok-4.6","patch_name":"gh_bobs-org__bob-cli","phase_bead_id":"bob-cli-fc.1","reasoning_effort":"high","vcs_provider":"GitHub"},"source_run_id":"run-acfd7cc74341f7b6cdd390ebce90dfe3","started_at":"2026-11-01T17:55:09.256257+00:00","state":"active"},{"capabilities":{"durably_revivable":true,"historically_viewable":true,"missing_requirements":[],"restartable":true},"commits":[],"dismissed_at":null,"files":{"chat":{"digest":"fa298a9acf12d941ba4f5ed81ff79e899d784b200d41f7d8c3a3dbc57d3ccd7f","path":"agents/bbugyi200.apollo.bob-cli-fc.land--plan/chat.md","size_bytes":7980},"commits":{"digest":"03e87cf0e9255a1fa8dbe18df22c0a7b5f015ac0c14189961b63bb057aaf45f2","path":"agents/bbugyi200.apollo.bob-cli-fc.land--plan/commits.json","size_bytes":89},"embedded_workflows":{"digest":"3942241a63c5de53df93bede886ed35a51f8b6a33d5883d819c898d7dd34f408","path":"agents/bbugyi200.apollo.bob-cli-fc.land--plan/embedded_workflows.json","size_bytes":83},"meta":{"digest":"bc937a910198d5b8404dcaf8e246a13c6e54d493662ae03e180817231ce2ce1f","path":"agents/bbugyi200.apollo.bob-cli-fc.land--plan/meta.json","size_bytes":836},"prompt":{"digest":"212152a5942c36df65e4b4b8b111701e7165d73b37aef09f23637c5a2e40c48a","path":"agents/bbugyi200.apollo.bob-cli-fc.land--plan/prompt.md","size_bytes":273},"state":{"digest":"7801fdf2c7de2073ba454158b43d0ef7b7dc3aad75c8373b0285e40a461c494a","path":"agents/bbugyi200.apollo.bob-cli-fc.land--plan/state.json","size_bytes":180}},"finished_at":null,"global_name":"