s/bbugyi200.apollo.bob-cli-2n.1/chat.md","size_bytes":4129},"commits":{"digest":"08875376b7c1311b610660ac6916c71f1594c9dcf374420489d6582f7093c0e2","path":"agents/bbugyi200.apollo.bob-cli-2n.1/commits.json","size_bytes":249},"embedded_workflows":{"digest":"3942241a63c5de53df93bede886ed35a51f8b6a33d5883d819c898d7dd34f408","path":"agents/bbugyi200.apollo.bob-cli-2n.1/embedded_workflows.json","size_bytes":83},"meta":{"digest":"bdb131fd8bf09c0d247a6443de2c7e36881a35423384f59c3c68c4ae7268ba5d","path":"agents/bbugyi200.apollo.bob-cli-2n.1/meta.json","size_bytes":6028},"prompt":{"digest":"22256f7dee92a7778c6b889556b80b38bc606b54d16d19a81ff289351e255fa8","path":"agents/bbugyi200.apollo.bob-cli-2n.1/prompt.md","size_bytes":184},"state":{"digest":"ba6c003660fc475e9971ef0ea0fab87a924a7705d99d9107662f2f7f4efd4f56","path":"agents/bbugyi200.apollo.bob-cli-2n.1/state.json","size_bytes":180}},"finished_at":null,"global_name":"bbugyi200.apollo.bob-cli-2n.1","local_name":"bob-cli-2n.1","metadata":{"agent_clan":"bob-cli-2n","agent_clan_generation":"20260929153538","approve":true,"bead_id":"bob-cli-2n.1","changespec_name":"gh_bobs-org__bob-cli","cl_name":"gh_bobs-org__bob-cli","clan_summary":"[bold #D75FFF]◆ EPIC bob-cli-2n[/bold #D75FFF]\n[dim]  Title: [bold #D7AFFF][/dim]Named and linked project tasks with ` :id` in `bob capture` and Bob[/bold #D7AFFF]\n[dim]         [bold #D7AFFF][/dim]Mac Capture[/bold #D7AFFF]\n[dim]   Goal: [#D7D7AF][/dim]A project-note capture (`@route^id+` or `@route^id+#pomodoro`) can [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]name any of its task bullets with a trailing ` ^id`, or name them [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]and link them into the current/next (or named) Pomodoro with a [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]trailing ` :id`. The `^prj` task is never linked, the retired [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]`@route:id+` forms fail with a message that teaches the new [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]spelling, and Bob Mac Capture highlights, completes, previews, and [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]reports the new syntax.[/#D7D7AF]\n[dim] Counts: [bold #D7AFFF][/dim]6[dim][/bold #D7AFFF] phases[dim][/dim] · [bold #D7AFFF][/dim]4[dim][/bold #D7AFFF] waves[/dim]\n[dim]   Path: [#87AFFF][/dim]plan:202609/[bold #87AFFF][/#87AFFF]project_task_links.md[/bold #87AFFF]\n[dim] Prompt: [#87AFFF][/dim]prompts/202609/project_task_links.md[/#87AFFF]\n[dim]   Bead: [#87AFFF][/dim]bob-cli-2n[/#87AFFF]\n[dim]   Page: [#87AFFF][/dim]https://github.com/bobs-org/bob-cli--beads/blob/main/pages/bob-cli-2n/[bold #87AFFF][/#87AFFF]README.md[/bold #87AFFF]\n[dim]  1 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Project-note marker grammar: `@route^id+#pomodoro`, retire [/bold #D7AFFF]   [bold black on #FFD75F] medium [/bold black on #FFD75F]\n      [bold #D7AFFF]`@route:id+`[/bold #D7AFFF]\n    [#AF87FF]marker[dim] · [dim][/dim]no dependencies[/#AF87FF][/dim]\n    [#D7D7AF]marker: move the Pomodoro name onto the `^` project-note marker [/#D7D7AF]\n    [#D7D7AF](`@route^id+#pomodoro`), retire the `:` project-note forms with teaching[/#D7D7AF]\n    [#D7D7AF]errors, stop linking or starring `^prj`, and keep execution, [/#D7D7AF]\n    [#D7D7AF]capture-parse, capture-complete, and help text in agreement.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  2 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Project task IDs in the capture grammar and capture-parse[/bold #D7AFFF]     [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]task-id-grammar[dim] · [dim][/dim]after marker[/#AF87FF][/dim]\n    [#D7D7AF]task-id-grammar: lex trailing ` :id` / ` ^id` tokens on project-note [/#D7D7AF]\n    [#D7D7AF]lines, enforce the placement, validity, duplicate, checkbox, and [/#D7D7AF]\n    [#D7D7AF]unused-`#pomodoro` rules in both the execution and editor parsers, and [/#D7D7AF]\n    [#D7D7AF]expose spans, needs, modes, and `sub_bullet_task_ids` through [/#D7D7AF]\n    [#D7D7AF]capture-parse.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  3 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Render named project tasks and write their Task Links[/bold #D7AFFF]         [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]task-id-execution[dim] · [dim][/dim]after task-id-grammar[/#AF87FF][/dim]\n    [#D7D7AF]task-id-execution: render `^id` onto named tasks (`[*]` for `:` tasks), [/#D7D7AF]\n    [#D7D7AF]write one Task Link per `:` task into the selected Pomodoro atomically [/#D7D7AF]\n    [#D7D7AF]with the new note, and report `project_note.task_links` in JSON and [/#D7D7AF]\n    [#D7D7AF]human output.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  4 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Block-ID completion for project task IDs[/bold #D7AFFF]                      [bold black on #87D7FF] small  [/bold black on #87D7FF]\n    [#AF87FF]task-id-completion[dim] · [dim][/dim]after task-id-grammar[/#AF87FF][/dim]\n    [#D7D7AF]task-id-completion: add the `project_task_block_id` capture-complete [/#D7D7AF]\n    [#D7D7AF]context with a `block_id` object (new intent, sibling and `prj` used [/#D7D7AF]\n    [#D7D7AF]IDs, body-derived suggestions) so editors can offer a New ID picker [/#D7D7AF]\n    [#D7D7AF]after ` :` or ` ^`.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  5 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Capture docs for named and linked project tasks[/bold #D7AFFF]               [bold black on #87D7FF] small  [/bold black on #87D7FF]\n    [#AF87FF]docs[dim] · [dim][/dim]after task-id-execution, task-id-completion[/#AF87FF][/dim]\n    [#D7D7AF]docs: rewrite the capture guide's grammar tables, Project notes section,[/#D7D7AF]\n    [#D7D7AF]JSON contract, and capture-parse/capture-complete references for the new[/#D7D7AF]\n    [#D7D7AF]syntax, with the worked example.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  6 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Bob Mac Capture support for project task links[/bold #D7AFFF]                [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]mac[dim] · [dim][/dim]after task-id-execution, task-id-completion[/#AF87FF][/dim]\n    [#D7D7AF]mac: in bob-mac-capture, color the new spans, route [/#D7D7AF]\n    [#D7D7AF]`project_task_block_id` into a Project task New ID picker, fix stale `+`[/#D7D7AF]\n    [#D7D7AF]teaching and `:` locator text, preview and notify linked tasks, update [/#D7D7AF]\n    [#D7D7AF]README, fixtures, and tests, and land a green macOS CI run.[/#D7D7AF]","clan_tribe":"epic","epic_bead_id":"bob-cli-2n","llm_provider":"muse","model":"muse-spark-1.3-contributor","patch_name":"gh_bobs-org__bob-cli","phase_bead_id":"bob-cli-2n.1","reasoning_effort":"xhigh","vcs_provider":"GitHub"},"source_run_id":"run-b3bc1c6c5974ed0dcc3f6b5f857a487a","started_at":"2026-09-29T19:35:50.932187+00:00","state":"active"},{"capabilities":{"durably_revivable":true,"historically_viewable":true,"missing_requirements":[],"restartable":true},"commits":[],"dismissed_at":null,"files":{"chat":{"digest":"be0bf69a007fd9c7a57f89687eb5f5f922f2b84f670d969b64ea9917270f7495","path":"agents/bbugyi200.apollo.bob-cli-2n.6--plan/chat.md","size_bytes":3322},"commits":{"digest":"b16e97de635c2c4a61f2bff8d50bfca443a3e4c708c6012ade50f62994bbb734","path":"agents/bbugyi200.apollo.bob-cli-2n.6--plan/commits.json","size_bytes":89},"embedded_workflows":{"digest":"3942241a63c5de53df93bede886ed35a51f8b6a33d5883d819c898d7dd34f408","path":"agents/bbugyi200.apollo.bob-cli-2n.6--plan/embedded_workflows.json","size_bytes":83},"meta":{"digest":"36587860d242766fa97d523142cd681a1c0c55a1e6b4f98d2f14cc61e06faf6a","path":"agents/bbugyi200.apollo.bob-cli-2n.6--plan/meta.json","size_bytes":856},"prompt":{"digest":"bb7680066c2dab2d88ff03dabf8be27ac680ac7d7e12b73685c3a6e8d1e79820","path":"agents/bbugyi200.apollo.bob-cli-2n.6--plan/prompt.md","size_bytes":194},"state":{"digest":"d10126392a6341753646b05a697f9e1eee4dffe72877490b2ae69cd503b30947","path":"agents/bbugyi200.apollo.bob-cli-2n.6--plan/state.j