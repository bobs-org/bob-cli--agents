s routing into a manifest of live tasks, and move tasks and [/#D7D7AF]\n    [#D7D7AF]Future Work bullets in verified batches. Attach refs, reconcile, sync [/#D7D7AF]\n    [#D7D7AF]projects, verify links, and summarize what is left for Bryan.[/#D7D7AF]","clan_tribe":"epic","created_epic_ids":["bob-cli-9y.1.1"],"epic_bead_id":"bob-cli-9y","llm_provider":"codex","model":"gpt-6-astra","patch_name":"gh_bobs-org__bob-cli","phase_bead_id":"bob-cli-9y.1","reasoning_effort":"xhigh","role_suffix":"plan","vcs_provider":"GitHub","workflow_name":"bob-cli-9y.1"},"source_run_id":"run-dbb124b5bb83a604579e591af6f05ca6","started_at":"2026-10-19T20:29:04.268217+00:00","state":"failed"},{"capabilities":{"durably_revivable":true,"historically_viewable":true,"missing_requirements":[],"restartable":true},"commits":[],"dismissed_at":null,"files":{"chat":{"digest":"24781c0126b2b5a28ee6c873c6d84a98076085985bf4659d47fa0f56008ac7bf","path":"agents/bbugyi200.athena.bob-cli-9y.1.1.2--1/chat.md","size_bytes":9008},"commits":{"digest":"668bb8d46b17becaf7e0f111bbf66eb5abcca8607aca1058374c7a18d7712165","path":"agents/bbugyi200.athena.bob-cli-9y.1.1.2--1/commits.json","size_bytes":89},"embedded_workflows":{"digest":"83facd5c5c4037dc8879b88a73b8b672b4d4fa04a67e211ef3b6099c5f98f499","path":"agents/bbugyi200.athena.bob-cli-9y.1.1.2--1/embedded_workflows.json","size_bytes":71},"meta":{"digest":"d691b732f43626a2ca38d69b2ee0cce6318b1fdcbfc5e85fbe7f05ee3c2eac81","path":"agents/bbugyi200.athena.bob-cli-9y.1.1.2--1/meta.json","size_bytes":681},"prompt":{"digest":"ea00b4661161f0bd1eaff4bcd113458aaa617abee085cea4f1b3db59b57583b0","path":"agents/bbugyi200.athena.bob-cli-9y.1.1.2--1/prompt.md","size_bytes":2768},"prompt_steps":{"digest":"ced690df1ef3207ec5adb17a6ee1f5d39c63ee403de5c049ca2bcd0bbff7f03a","path":"agents/bbugyi200.athena.bob-cli-9y.1.1.2--1/prompt_steps.json","size_bytes":1046},"state":{"digest":"3d6c80fcbb82607d3877f11392b63f83de1a68f553dd7a294bfbfed488a20be6","path":"agents/bbugyi200.athena.bob-cli